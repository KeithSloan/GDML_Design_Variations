# Machine-specific settings for the pipeline scripts.  Copy to
# pipeline/local.env (not committed) and edit.  KEY=VALUE, no quotes.
# Anything set in the environment overrides these.

# FreeCAD used to generate GDML (default: newest /Applications/FreeCAD*.app)
FREECAD=/Applications/FreeCAD_1.1.4.app

# Parallel Geant4 processes (default: CPU cores - 1)
# JOBS=6

# Python for the pipeline (default: the active conda environment's)
# PYTHON=/path/to/python3
